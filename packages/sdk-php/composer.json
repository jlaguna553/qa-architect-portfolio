{
  "name": "qa-architect/sdk-symfony",
  "description": "SDK de telemetría para Symfony - QA Arquitecto",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "QaArchitect\\SdkSymfony\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "symfony/event-dispatcher": "^6.0|^7.0",
    "symfony/http-kernel": "^6.0|^7.0",
    "symfony/http-foundation": "^6.0|^7.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "symfony/framework-bundle": "^6.0|^7.0"
  },
  "config": {
    "sort-packages": true
  }
}
